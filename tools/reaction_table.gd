extends SceneTree
## H427: the side-by-side reference of every reaction and eruption, from the
## LIVE tune values (HHFormulas.reaction_table), as x the triggering hunter's
## auto attack and as damage for each weapon. Rerun after any reaction retune:
##   godot --headless --path . --script res://tools/reaction_table.gd [-- --md design/elements/reaction_table.md]


func _initialize() -> void:
	_go.call_deferred()


func _go() -> void:
	var args := OS.get_cmdline_user_args()
	var i := args.find("--md")
	var out := args[i + 1] if i >= 0 and i + 1 < args.size() else "res://design/elements/reaction_table.md"
	var md := render()
	var f := FileAccess.open(out, FileAccess.WRITE)
	f.store_string(md)
	f.close()
	print(md)
	print("wrote ", out)
	quit(0)


## The reaction unit for `weapon` (H50: the basic at the lance's cadence).
static func unit(weapon: String) -> float:
	return HHWeapons.basic_damage(weapon) * HHTune.value("lance_basic_ticks") / maxf(1.0, float(HHWeapons.basic_ticks(weapon)))


static func render() -> String:
	var weapons := ["lance", "daggers", "bow"]
	var L: Array = []
	L.append("# Reaction table (generated)")
	L.append("")
	L.append("Generated by `tools/reaction_table.gd` from the live `HHTune` values (`HHFormulas.reaction_table`). Do not edit by hand: retune on F1 or in `src/core/tune.gd` (the \"eruptions and reactions\" section), then rerun the tool.")
	L.append("")
	L.append("Every reaction deals **the triggering hunter's auto attack x its multiple** (H50, H427). The auto attack here is the reaction unit: the weapon's basic at the lance's cadence (`basic_damage x lance_basic_ticks / basic_ticks`: a fast weapon's light hits do not make its reactions small):")
	L.append("")
	var u_parts: Array = []
	for w in weapons:
		u_parts.append("%s %.0f (basic %.0f every %d ticks)" % [w, unit(w), HHWeapons.basic_damage(w), HHWeapons.basic_ticks(w)])
	L.append("- " + "; ".join(u_parts) + ".")
	L.append("- Centre hex in full; the ring round it takes the reaction's own `*_ring_frac` (detonate %.2f, steam %.2f, eclipse %.2f, shatter %.2f, bursts %.2f / %.2f / %.2f / %.2f)." % [
		HHTune.value("detonate_ring_frac"), HHTune.value("steam_ring_frac"), HHTune.value("eclipse_ring_frac"), HHTune.value("shatter_ring_frac"),
		HHTune.value("overheat_ring_frac"), HHTune.value("geyser_ring_frac"), HHTune.value("glint_ring_frac"), HHTune.value("flux_ring_frac")])
	L.append("- A monster- or arena-triggered reaction (3.3): the monster takes %.0f%% of these numbers, each hunter in it %.0f%% (never below 1 HP). An exposed monster (Eclipse, H57) takes x%.2f from every hunter; a vulnerable one (Flux) x%.2f from reactions." % [
		100.0 * HHTune.value("monster_reaction_frac"), 100.0 * HHTune.value("monster_reaction_player_frac"), HHTune.value("exposed_dmg_mult"), HHTune.value("flux_vuln_mult")])
	L.append("")
	L.append("| Reaction | Case | x auto attack | lance | daggers | bow | Anchor |")
	L.append("|---|---|---|---|---|---|---|")
	for r in HHFormulas.reaction_table():
		var dm: Array = []
		for w in weapons:
			dm.append("-" if str(r.reaction) == "Swirl" else "%.0f" % (unit(w) * float(r.mult)))
		L.append("| %s | %s | x%s | %s | %s |" % [r.reaction, r.case, _num(float(r.mult)), " | ".join(dm), str(r.anchor)])
	L.append("")
	return "\n".join(L) + "\n"


static func _num(v: float) -> String:
	var s := "%.3f" % v
	while s.ends_with("0"):
		s = s.substr(0, s.length() - 1)
	if s.ends_with("."):
		s = s.substr(0, s.length() - 1)
	return s
