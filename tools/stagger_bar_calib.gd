extends SceneTree
## Lane SB (H511): the stagger bar's calibration anchor, measured.
##
## ONE FULL WATER COMBO = a hunter with water ACTIVE, standing at its attack
## spot on a still monster, doing the weapon's whole basic string (lance and
## daggers: the 3-hit combo; the bow has no combo, H57, so 3 arrows), counted
## with every reaction its own water triggers on the monster along the way
## (the Geysers: water 3 under the blows erupts on the next water blow). No
## skills, no dodging: the number is the string itself, reproducible.
##
## For every weapon and every element the bot strings N combos from a fresh
## fight and records the bar after each one (the bar never topples here:
## sb_need is raised out of reach, decay is off). The page says how many
## combos each pair needs for today's sb_need, and which reactions fed it.
##   godot --headless --path . --script res://tools/stagger_bar_calib.gd [-- --combos 12 --md design/stagger_bar.md]

const WEAPONS := ["lance", "daggers", "bow"]


func _initialize() -> void:
	_go.call_deferred()


func _go() -> void:
	var args := OS.get_cmdline_user_args()
	var i := args.find("--md")
	var out := args[i + 1] if i >= 0 and i + 1 < args.size() else "res://design/stagger_bar.md"
	var j := args.find("--combos")
	var n := int(args[j + 1]) if j >= 0 and j + 1 < args.size() else 12
	var md := render(n)
	var f := FileAccess.open(out, FileAccess.WRITE)
	f.store_string(md)
	f.close()
	print(md)
	print("wrote ", out)
	quit(0)


## A fresh sim: one hunter (`weapon`, `element` active) and a still monster
## (no brain, no resist, HP out of reach). The bar is measured, never full.
static func fresh(weapon: String, element: String, seed: int = 1) -> HHSim:
	var s := HHSim.new(HHArena.round_flat(seed, 17.5, 0.0), seed)
	s.add_player("p1", Vector2i(0, 4), element, "fire" if element != "fire" else "water", weapon)
	s.add_monster("m", Vector2i(0, -2), 1.0e9, 2)
	return s


## String `n` full basic combos with `element` active; returns { fills: [the
## bar after combo 1, 2, ... n], per: [fill each combo added], sources:
## { cause: fill }, ticks }. Topple and decay are held off for the run (the
## tune is restored after).
static func measure(weapon: String, element: String, n: int, seed: int = 1) -> Dictionary:
	var keep_need := HHTune.value("sb_need")
	var keep_delay := HHTune.value("sb_decay_delay_s")
	HHTune.set_value("sb_need", 1.0e9)
	HHTune.set_value("sb_decay_delay_s", 1.0e9)
	var s := fresh(weapon, element, seed)
	var m := s.unit("m")
	var fills: Array = []
	var per: Array = []
	var sources := {}
	var hits := 0
	var last := 0.0
	var limit := 30 * 20 * n + 600
	for t in limit:
		var before := float(m.sbar)
		var ev := s.step({ "p1": { "target": "m", "attack": true } } if t == 0 else {})
		var gained := float(m.sbar) - before
		var basic_landed := false
		var finisher := false
		var cause := ""
		for e in ev:
			if str(e.type) == "strike" and str(e.id) == "p1" and str(e.cause) == "basic":
				basic_landed = true
				hits += 1
				finisher = int(e.get("combo", 0)) >= 3 if weapon != "bow" else hits % 3 == 0
			elif str(e.type) in ["geyser", "steam", "shatter", "detonate", "glint", "eclipse", "overheat", "flux"]:
				cause = str(e.type)
		if gained > 0.0:
			var k := "basic" if cause == "" else "basic + " + cause
			sources[k] = float(sources.get(k, 0.0)) + gained
		if basic_landed and finisher:
			fills.append(float(m.sbar))
			per.append(float(m.sbar) - last)
			last = float(m.sbar)
			if fills.size() >= n:
				break
	var ticks := s.tick
	HHTune.set_value("sb_need", keep_need)
	HHTune.set_value("sb_decay_delay_s", keep_delay)
	return { "fills": fills, "per": per, "sources": sources, "ticks": ticks }


## Combos (1-based) a fresh run needs to reach `need`, else -1.
static func combos_to(fills: Array, need: float) -> int:
	for i in fills.size():
		if float(fills[i]) >= need - 1e-6:
			return i + 1
	return -1


static func render(n: int) -> String:
	var L: Array = []
	L.append("# Stagger bar calibration (generated)")
	L.append("")
	L.append("Generated by `tools/stagger_bar_calib.gd` (Lane SB, H511) from the live `HHTune` values. Do not edit by hand.")
	L.append("")
	L.append("**One full water combo** = a hunter with water ACTIVE at its attack spot on a still monster, doing the weapon's whole basic string (lance / daggers: the 3-hit combo; the bow has no combo, so 3 arrows), counted with every reaction its own water sets off on the monster (the Geysers). No skills. Fill = stagger x the element's or reaction's factor (`sb_hit_<element>`, `sb_<reaction>`), through `HHFormulas.stagger_fill`.")
	L.append("")
	L.append("Threshold today: `sb_need` = **%.1f** (solo, first topple; x(1 + %.2f per extra hunter), x%.1f per topple so far). A combo is a water reaction (H520)." % [HHTune.value("sb_need"), HHTune.value("sb_party_mult"), HHTune.value("sb_rise_mult")])
	L.append("")
	L.append("## Water: the anchor, per weapon")
	L.append("")
	L.append("| weapon | combo 1 | combo 2 | steady combo | after 9 | after 10 | combos to topple | seconds of string per combo |")
	L.append("|---|---|---|---|---|---|---|---|")
	for w in WEAPONS:
		var r := measure(w, "water", n)
		var f: Array = r.fills
		var p: Array = r.per
		var steady := 0.0
		for k in range(2, p.size()):
			steady += float(p[k])
		steady /= maxf(1.0, float(p.size() - 2))
		L.append("| %s | %.2f | %.2f | %.2f | %.2f | %.2f | %d | %.1f |" % [w, float(p[0]), float(p[1]), steady, float(f[8]), float(f[9]),
			combos_to(f, HHTune.value("sb_need")), float(r.ticks) / 30.0 / float(f.size())])
	L.append("")
	L.append("## Every element, per weapon: steady fill per combo, and as a share of water's")
	L.append("")
	L.append("| weapon | " + " | ".join(HHFormulas.ELEMENTS) + " |")
	L.append("|---|" + "---|".repeat(HHFormulas.ELEMENTS.size()))
	var src_lines: Array = []
	for w in WEAPONS:
		var cells: Array = []
		var water := 0.0
		var by := {}
		for el in HHFormulas.ELEMENTS:
			var r := measure(w, el, n)
			var tot := float((r.fills as Array).back()) if not (r.fills as Array).is_empty() else 0.0
			by[el] = tot / float(maxi(1, (r.fills as Array).size()))
			if el == "water":
				water = float(by[el])
			if w == "lance":
				var parts: Array = []
				var ks: Array = (r.sources as Dictionary).keys()
				ks.sort()
				for k in ks:
					parts.append("%s %.2f" % [k, float(r.sources[k])])
				src_lines.append("- lance, %s: %s (over %d combos)" % [el, ", ".join(PackedStringArray(parts)) if not parts.is_empty() else "nothing", (r.fills as Array).size()])
		for el in HHFormulas.ELEMENTS:
			cells.append("%.2f (%d%%)" % [float(by[el]), int(roundf(100.0 * float(by[el]) / maxf(0.001, water)))])
		L.append("| %s | %s |" % [w, " | ".join(PackedStringArray(cells))])
	L.append("")
	L.append("Average over %d combos from a fresh fight (the first combos build the ground up)." % n)
	L.append("")
	L.append("## Where the fill came from (lance)")
	L.append("")
	L.append("Fill on ticks with only a blow (\"basic\") and on ticks where the blow also set off a reaction (\"basic + <reaction>\": the blow's fill plus the reaction's; Overheat and Flux carry no stagger, so theirs is the blow alone).")
	L.append("")
	L.append_array(src_lines)
	L.append("")
	L.append("## The factors")
	L.append("")
	L.append("| source | factor | its stagger | fill per hit |")
	L.append("|---|---|---|---|")
	for el in HHFormulas.ELEMENTS:
		L.append("| a %s blow (basic 1, x the hit's stagger) | %.2f | %.2f | %.3f |" % [el, HHTune.value("sb_hit_" + el), HHTune.value("basic_stagger"),
			float(HHFormulas.stagger_fill(HHTune.value("basic_stagger"), "sb_hit_" + el).value)])
	for k in ["geyser", "steam", "shatter", "detonate", "glint", "eclipse", "overheat", "flux"]:
		L.append("| %s | %.2f | %.2f | %.3f |" % [k.capitalize(), HHTune.value("sb_" + k), HHTune.value(k + "_stagger"),
			float(HHFormulas.stagger_fill(HHTune.value(k + "_stagger"), "sb_" + k).value)])
	L.append("")
	return "\n".join(PackedStringArray(L)) + "\n"
